# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ARG PRISM_LLAMA_TAG=prism-b10709-9a9394a

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libgomp1 python3 tar xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Scarica ed estrae i binari CUDA x64 del fork PrismML-Eng/llama.cpp
RUN set -eux; \
    ASSET="llama-${PRISM_LLAMA_TAG}-bin-linux-cuda-12.4-x64.tar.gz"; \
    echo ">> Release asset: ${ASSET}"; \
    curl -fL --retry 3 --retry-delay 5 \
      -o /tmp/llama.tar.gz \
      "https://github.com/PrismML-Eng/llama.cpp/releases/download/${PRISM_LLAMA_TAG}/${ASSET}"; \
    mkdir -p /opt/llama; \
    tar -xzf /tmp/llama.tar.gz -C /opt/llama --strip-components=1; \
    rm -f /tmp/llama.tar.gz

# Sanity-check versione binario
RUN set -eux; \
    BIN="$(find /opt/llama -type f -name llama-server | head -n1)"; \
    if ! LD_LIBRARY_PATH="$(dirname "${BIN}")" "${BIN}" --version >/dev/null 2>/tmp/llama-check.log; then \
      if grep -q "libcuda.so.1" /tmp/llama-check.log; then \
        echo "AVVISO: libcuda.so.1 non presente durante la build. Proseguo..."; \
      else \
        cat /tmp/llama-check.log >&2; \
        exit 1; \
      fi; \
    fi; \
    rm -f /tmp/llama-check.log

# Boot test dei flag dell'entrypoint
RUN set -eux; \
    BIN="$(find /opt/llama -type f -name llama-server | head -n1)"; \
    export LD_LIBRARY_PATH="$(dirname "${BIN}")"; \
    BOOT_LOG=/tmp/llama-boot.log; \
    "${BIN}" --models-dir /tmp --host 127.0.0.1 --port 8099 --ctx-size 8 \
      --parallel 1 --cache-type-k q4_0 --cache-type-v q4_0 \
      --batch-size 16 --ubatch-size 16 --n-gpu-layers 0 \
      --jinja --no-models-autoload >"${BOOT_LOG}" 2>&1 & \
    BPID=$!; \
    OK=0; \
    for i in $(seq 1 60); do \
      if curl -fsS --max-time 2 http://127.0.0.1:8099/health >/dev/null 2>&1; then OK=1; break; fi; \
      kill -0 "${BPID}" 2>/dev/null || break; \
      sleep 0.5; \
    done; \
    kill "${BPID}" 2>/dev/null || true; \
    if [ "${OK}" != "1" ]; then \
      if grep -q "libcuda.so.1" "${BOOT_LOG}"; then \
        echo "AVVISO: libcuda.so.1 non presente durante il boot test. Proseguo..."; \
      else \
        cat "${BOOT_LOG}" >&2; \
        exit 1; \
      fi; \
    fi; \
    rm -f "${BOOT_LOG}"

COPY scripts/entrypoint-llama.sh /usr/local/bin/entrypoint-llama.sh
COPY scripts/llama-gguf-mem.py /usr/local/bin/llama-gguf-mem.py
RUN chmod +x /usr/local/bin/entrypoint-llama.sh /usr/local/bin/llama-gguf-mem.py

WORKDIR /models
ENTRYPOINT ["/usr/local/bin/entrypoint-llama.sh"]